namespace GuzzleHttp;

/**
 * Analysis metadata for the concrete API retained by supported Guzzle versions.
 * The deprecated Guzzle 7 ClientInterface contract remains unchanged.
 */
class Client
{
    /**
     * @not-deprecated
     * @param string|null $option
     * @return ($option is null ? array<string, mixed> : mixed)
     */
    public function getConfig(?string $option = null)
    {
    }
    /**
     * Native Guzzle 7/8 constructor configuration is an open option bag.
     * Request-only PHPDoc cannot describe defaults stored for later middleware.
     * The native constructor retains its own handler/factory/URI/sharing checks.
     * @param array<array-key,mixed> $config
     */
    public function __construct(array $config = [])
    {
    }
}
