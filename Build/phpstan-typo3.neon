includes:
    - ../vendor/netresearch/typo3-ci-workflows/config/phpstan/phpstan.neon

parameters:
    level: 8
    paths:
        - ../Classes
    excludePaths:
        analyseAndScan:
            - ../Classes/HttpGuard
            - ../Classes/Http/GuardedRequestFactory13.php
    tmpDir: /tmp/nr-http-guard-combined-phpstan-core14
