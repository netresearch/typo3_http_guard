includes:
    - ../.Build/vendor/netresearch/typo3-ci-workflows/config/phpstan/phpstan.neon

parameters:
    level: 10
    stubFiles:
        - PhpStan/Client.stub
    paths:
        - ../Classes
    excludePaths:
        analyseAndScan:
            - ../Classes/HttpGuard
            - ../Classes/Http/GuardedRequestFactory13.php
    tmpDir: /tmp/nr-http-guard-combined-phpstan-core14
