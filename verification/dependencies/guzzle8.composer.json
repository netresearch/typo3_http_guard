{
    "name": "netresearch/http-guard",
    "description": "Explicit outbound HTTP policy with isolated pinned curl-multi transport",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "8.2.0",
        "guzzlehttp/promises": "3.0.2",
        "guzzlehttp/psr7": "3.1.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Netresearch\\HttpGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netresearch\\HttpGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "analyse": "phpstan analyse --configuration phpstan.neon"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.2.33"
        }
    }
}
