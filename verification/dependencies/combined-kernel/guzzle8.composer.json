{
  "name": "netresearch/nr-http-guard-kernel-test-guzzle8",
  "description": "Kernel-only verification fixture for the combined TYPO3 extension; not a production package",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "guzzlehttp/guzzle": "8.2.0",
    "guzzlehttp/promises": "3.0.2",
    "guzzlehttp/psr7": "3.1.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "Netresearch\\HttpGuard\\": "Classes/HttpGuard/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Netresearch\\HttpGuard\\Tests\\": "Tests/HttpGuard/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration Build/phpunit-http-guard.xml",
    "analyse": "phpstan analyse --configuration Build/phpstan-http-guard.neon"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.2.33"
    }
  }
}
