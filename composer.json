{
  "name": "netresearch/nr-http-guard",
  "description": "HTTP Guard - Controlled outbound HTTP policy for verified TYPO3 client combinations",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "typo3/cms-core": "13.4.35 || 14.3.7",
    "guzzlehttp/guzzle": "7.15.3 || 7.15.5 || 8.2.0",
    "guzzlehttp/promises": "2.5.2 || 2.5.3 || 3.0.2",
    "guzzlehttp/psr7": "2.13.0 || 2.13.1 || 3.1.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "symfony/console": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
    "phpstan/phpstan": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "Netresearch\\NrHttpGuard\\": "Classes/",
      "Netresearch\\HttpGuard\\": "Classes/HttpGuard/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Netresearch\\NrHttpGuard\\Tests\\": "Tests/",
      "Netresearch\\HttpGuard\\Tests\\": "Tests/HttpGuard/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "nr_http_guard",
      "version": "0.1.0",
      "Package": {
        "providesPackages": {}
      }
    }
  }
}
