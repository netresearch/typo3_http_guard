{
  "name": "netresearch/nr-http-guard",
  "description": "HTTP Guard - Controlled outbound HTTP protection for qualified TYPO3 client combinations - by Netresearch",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "typo3/cms-core": "^13.4.36 || ^14.3.8",
    "guzzlehttp/guzzle": "^7.15.2 || ^8.2",
    "guzzlehttp/promises": "^2.5.1 || ^3.0.2",
    "guzzlehttp/psr7": "^2.13 || ^3.1",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "symfony/console": "^7.4"
  },
  "require-dev": {
    "netresearch/typo3-ci-workflows": "^1.12",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Netresearch\\NrHttpGuard\\": "Classes/",
      "Netresearch\\HttpGuard\\": "Classes/HttpGuard/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Netresearch\\NrHttpGuard\\Tests\\": "Tests/",
      "Netresearch\\HttpGuard\\Tests\\": "Tests/HttpGuard/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "nr_http_guard",
      "version": "0.1.1",
      "Package": {
        "providesPackages": {}
      }
    }
  },
  "homepage": "https://github.com/netresearch/typo3_http_guard",
  "support": {
    "issues": "https://github.com/netresearch/typo3_http_guard/issues",
    "source": "https://github.com/netresearch/typo3_http_guard",
    "docs": "https://github.com/netresearch/typo3_http_guard/tree/main/Documentation"
  },
  "authors": [
    {
      "name": "Netresearch DTT GmbH",
      "homepage": "https://www.netresearch.de/",
      "role": "Maintainer"
    }
  ],
  "keywords": [
    "typo3",
    "extension",
    "http",
    "ssrf",
    "security",
    "guzzle",
    "psr-18"
  ],
  "config": {
    "allow-plugins": {
      "a9f/fractor-extension-installer": true,
      "captainhook/hook-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "sort-packages": true
  }
}
