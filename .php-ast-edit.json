{
  "canonical": true,
  "printWidth": 120,
  "exclude": [
    "vendor",
    ".Build",
    ".git",
    "evidence",
    "verification",
    "specification",
    "integrations",
    "Build/Reports",
    "Resources/Private/HttpGuard/data/security-corpus",
    "ext_emconf.php"
  ],
  "formatter": [
    "php",
    ".Build/vendor/bin/php-cs-fixer",
    "fix",
    "--config=.php-cs-fixer.dist.php",
    "--path-mode=intersection",
    "{files}"
  ]
}
