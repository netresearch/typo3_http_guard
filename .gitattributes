# Source-bound delivery: retain exact bytes when checked out on any platform.
* -text
# Imported originals and runtime witnesses retain their recorded whitespace.
Resources/Private/HttpGuard/data/security-corpus/** -whitespace
# Raw assessment console logs retain the tool's exact output, including padding.
Build/Reports/Assessment/**/*.log -whitespace
# Keep the exact qualified analysis configuration, including its final blank line.
Build/phpstan-http-guard.neon whitespace=-blank-at-eof

# RST manuals use equals-sign headings.
Documentation/** conflict-marker-size=128

# Publish the complete single extension without repository-only tools or evidence.
# Keep this boundary aligned with Build/Scripts/build-extension.py and Tailor.
* export-ignore
/composer.json -export-ignore
/ext_emconf.php -export-ignore
/ext_localconf.php -export-ignore
/README.md -export-ignore
/LICENSE.txt -export-ignore
/LICENSE-HttpGuard.txt -export-ignore
/LICENSES.md -export-ignore
/Classes -export-ignore
/Classes/** -export-ignore
/Configuration -export-ignore
/Configuration/** -export-ignore
/Documentation -export-ignore
/Documentation/** -export-ignore
/Resources -export-ignore
/Resources/** -export-ignore
/Resources/Private/HttpGuard/data/security-corpus/** export-ignore
/Resources/Private/HttpGuard/data/security-corpus/README.md -export-ignore
/Resources/Private/HttpGuard/data/security-corpus/address-rules.json -export-ignore
/Resources/Private/HttpGuard/data/security-corpus/address-cases.json -export-ignore
/Resources/Private/HttpGuard/data/security-corpus/endpoint-cases.json -export-ignore
/Resources/Private/HttpGuard/data/security-corpus/uri-cases.json -export-ignore
/Resources/Private/HttpGuard/data/security-corpus/scenario-cases.json -export-ignore
/Resources/Private/HttpGuard/data/security-corpus/sources.json -export-ignore
