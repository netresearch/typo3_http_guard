{
  "$schema": ".Build/vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": [
      "Classes"
    ]
  },
  "timeout": 10,
  "threads": 4,
  "phpUnit": {
    "configDir": "Build/Mutation",
    "customPath": ".Build/vendor/bin/phpunit"
  },
  "tmpDir": ".Build/cache/infection",
  "logs": {
    "json": ".Build/reports/infection.json",
    "summaryJson": ".Build/reports/infection-summary.json",
    "text": ".Build/reports/infection.log"
  },
  "mutators": {
    "@default": true
  },
  "minMsi": 90,
  "minCoveredMsi": 90,
  "bootstrap": "Build/Mutation/bootstrap.php"
}
