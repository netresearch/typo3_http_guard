{
  "config": {
    "verbosity": "normal",
    "fail-on-first-error": true,
    "ansi-colors": false,
    "bootstrap": ".Build/vendor/autoload.php"
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "composer check:secrets"
      },
      {
        "action": "composer check:local"
      }
    ]
  },
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
        "options": {
          "regex": "#\\A(feat|fix|chore|docs|test|refactor|style|ci|perf|build|revert)(\\([^)\\r\\n]+\\))?!?: [^\\r\\n]{1,72}(?:\\r?\\n|\\z)#",
          "error": "Use a Conventional Commit subject."
        }
      },
      {
        "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
        "options": {
          "regex": "#(?m)^Signed-off-by: [^<>\\r\\n]+ <[^<>\\s]+@[^<>\\s]+>\\r?$#",
          "error": "Include your DCO Signed-off-by trailer."
        }
      }
    ]
  },
  "pre-push": {
    "enabled": true,
    "actions": [
      {
        "action": "composer ci:test:php:unit"
      }
    ]
  }
}
